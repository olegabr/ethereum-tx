{
    "name": "olegabr/ethereum-tx",
    "description": "Ethereum transaction library in PHP.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "sc0Vu",
            "email": "alk03073135@gmail.com"
        },
        {
            "name": "Oleg Abrosimov",
            "email": "olegabrosimovnsk@gmail.com"
        }
    ],
    "config": {
        "fxp-asset": {
            "vcs-driver-options": {
                "github-no-api": true
            }
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "Web3p\\EthereumTx\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Test\\": "test/"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/olegabr/rlp"
        },
        {
            "type": "vcs",
            "url": "https://github.com/olegabr/ethereum-util"
        },
        {
            "type": "vcs",
            "url": "https://github.com/olegabr/php-keccak"
        }
    ],
    "require": {
        "php": "^7.0 || ^8.0",
        "olegabr/rlp": "^0.3.6 || ^0.4",
        "olegabr/ethereum-util": "~0.1",
        "olegabr/keccak": "~1",
        "simplito/elliptic-php": "~1.0.6"
    }
}
